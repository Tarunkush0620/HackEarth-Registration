# ---- Razorpay (start with TEST keys: rzp_test_...) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Set the same secret in Razorpay Dashboard > Webhooks
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# ---- Supabase (Project Settings > API) ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-side only, never expose in frontend

# ---- QR signing (the scanner site must use the SAME value) ----
QR_SECRET=another-long-random-string

# ---- Email (SMTP). Gmail: smtp.gmail.com / 465 / app password ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ieeegusb@galgotiasuniversity.edu.in
SMTP_PASS=your-app-password
MAIL_FROM="WIE HackEarth 2.0 <ieeegusb@galgotiasuniversity.edu.in>"
MAIL_REPLY_TO=ieeegusb@galgotiasuniversity.edu.in

# ---- Event settings ----
REG_FEE_INR=400
ALL_FEMALE_FEE_INR=200
ACCOMMODATION_FEE_PER_PERSON_INR=1500
EVENT_DATES=29-30 Nov 2026
EVENT_VENUE=Galgotias University, Greater Noida
# true = only teams whose leader email is in the `shortlist` table can pay
REQUIRE_SHORTLIST=true
# Passcode the volunteers type to unlock the entry desk scanner (/scanner)
SCANNER_PASSCODE=hackearth2026
